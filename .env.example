# Verde Marea — переменные окружения. Скопируйте файл в .env:
#   macOS / Linux:        cp .env.example .env
#   Windows (PowerShell): Copy-Item .env.example .env
# Настоящий .env в репозиторий не попадает (.gitignore).

# --- База данных -----------------------------------------------------------------------
# Две базы: основная (verde_marea) и пустая служебная shadow для Prisma (verde_marea_shadow).
# Формат: postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@localhost:5432/ИМЯ_БАЗЫ?schema=public
#
# macOS, Postgres.app или Homebrew: пользователь — ваш логин macOS, пароля нет:
#   postgresql://ваш_логин@localhost:5432/verde_marea?schema=public
# Linux (Ubuntu/Debian): роль, созданная по README (sudo -u postgres createuser …), с паролем:
#   postgresql://verde:пароль_роли@localhost:5432/verde_marea?schema=public
# Windows, установщик EDB: пользователь postgres и пароль, заданный при установке:
#   postgresql://postgres:пароль_postgres@localhost:5432/verde_marea?schema=public
# Спецсимволы в пароле (@ : / # ? %) кодируйте: @ → %40, # → %23 и т. д.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/verde_marea?schema=public"
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/verde_marea_shadow?schema=public"

# --- Учебные демо-данные seed ----------------------------------------------------------
# Фиксированные значения для локальной проверки проекта (решение автора, см. AGENTS.md и README).
# Это не секреты и не настоящие пароли — для любого другого окружения замените их.
SEED_SUPER_ADMIN_EMAIL="owner@verde-marea.test"
SEED_SUPER_ADMIN_NAME="Лаура Верди"
SEED_SUPER_ADMIN_PASSWORD="VerdeMarea-Owner-2026"
# Пароль демо-пользователей: admin@verde-marea.test, anna@verde-marea.test, pavel@verde-marea.test
SEED_DEMO_PASSWORD="VerdeMarea-Demo-2026"
